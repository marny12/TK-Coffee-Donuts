# Copy to .env.local for local work. Never commit real values.
# Maintenance is ON in code unless this is explicitly set to false.
MAINTENANCE_MODE=true

# Passwords for the maintenance-wall doors. Two ways to set them:
# SIMPLE: type the password itself as the value in Vercel.
SITE_ACCESS_PASSWORD=
ADMIN_PASSWORD=
# STRONGER (optional): store a scrypt hash instead. Generate with: npm run hash-password
# If both are set for a door, the HASH wins and the plain password is ignored.
SITE_ACCESS_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Long random signing secret for access/admin/customer cookies.
AUTH_SECRET=

# Postgres connection string (Neon in production). Omit locally to use .data/tk-store.json.
DATABASE_URL=

# Local-only escape hatch. In production these placeholder passwords are always refused.
ALLOW_DEV_PLACEHOLDERS=false

# --- Online ordering → TK POS (server-side only; never shipped to the browser) ---
# The SAME strong random value must be set as TK_INTAKE_KEY on the TK POS
# Vercel project (tk-pos). With it unset here, /api/orders refuses orders.
TK_INTAKE_KEY=
# Defaults to https://tk-pos-three.vercel.app/api when unset.
TK_POS_API_URL=

# --- Square card pay (optional; OFF until every value below is set) ---
# SQUARE_ENABLED must be exactly "true" AND all three ids set, or the
# "Pay now with card" choice stays hidden and the orders route refuses it.
SQUARE_ENABLED=false
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
