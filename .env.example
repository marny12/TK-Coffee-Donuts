# Copy to .env.local for local work. Never commit real values.
# Maintenance is ON in code unless this is explicitly set to false.
MAINTENANCE_MODE=true

# Required in production. Generate hashes with: npm run hash-password
SITE_ACCESS_PASSWORD_HASH=
ADMIN_PASSWORD_HASH=

# Long random signing secret for access/admin/customer cookies.
AUTH_SECRET=

# Postgres connection string (Neon in production). Omit locally to use .data/tk-store.json.
DATABASE_URL=

# Local-only escape hatch. In production these placeholder passwords are always refused.
ALLOW_DEV_PLACEHOLDERS=false
